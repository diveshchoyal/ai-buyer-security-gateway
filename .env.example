# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
SUPABASE_PROJECT_ID=your_project_ref_here
SUPABASE_URL=https://your_project_ref_here.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Frontend Client Environment (Vite)
# Public variables only - NEVER include service-role or secret keys here
VITE_SUPABASE_URL=https://your_project_ref_here.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_or_anon_key_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Payment Rail Configuration (Razorpay - SERVER-SIDE ONLY)
# Set via Supabase CLI: supabase secrets set RAZORPAY_KEY_SECRET=...
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AI Agent Shopper Configuration (Groq LLM - SERVER-SIDE ONLY)
# Set via Supabase CLI: supabase secrets set AGENT_LLM_API_KEY=...
AGENT_LLM_API_KEY=your_groq_or_openai_api_key_here
AGENT_LLM_MODEL=llama-3.3-70b-versatile
