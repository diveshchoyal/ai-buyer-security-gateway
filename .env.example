# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
SUPABASE_PROJECT_ID=your_project_ref_here
SUPABASE_URL=https://your_project_ref_here.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Payment Rail Configuration (Razorpay)
# Kept strictly server-side in Edge Functions / backend vault
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
